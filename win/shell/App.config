<?xml version="1.0" encoding="utf-8"?>
<!-- .NET Framework 4.8.1, and WPF's per-monitor DPI scaling on (app.md §4.6: the manifest's
     PerMonitorV2 with DoNotScaleForDpiChanges=false, supported from 4.6.2). -->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
  </startup>
  <runtime>
    <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false" />
  </runtime>
</configuration>
