// A version resource shaped as rekordbox.exe's (phase0-probes §0: ProductVersion 7.2.19.0342), for
// compat.c's PE reader tests: run.sh builds it into a tiny x64 and arm64 exe.
1 VERSIONINFO
FILEVERSION 7,2,19,342
PRODUCTVERSION 7,2,19,342
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RB Stems Plus tests"
            VALUE "FileDescription", "a stand-in for rekordbox.exe"
            VALUE "FileVersion", "7.2.19.0342"
            VALUE "ProductName", "rekordbox"
            VALUE "ProductVersion", " 7.2.19.0342 "
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
