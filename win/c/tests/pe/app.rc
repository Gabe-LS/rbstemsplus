// A version resource shaped as the WPF app's (release.md §3.2: ProductVersion the full version), for
// update.c's check of an unpacked app: run.sh builds it into a tiny x64 exe.
1 VERSIONINFO
FILEVERSION 1,5,3,0
PRODUCTVERSION 1,5,3,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RB Stems Plus tests"
            VALUE "FileDescription", "a stand-in for the WPF app"
            VALUE "FileVersion", "1.5.3.0"
            VALUE "ProductName", "RB Stems Plus"
            VALUE "ProductVersion", "1.5.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
