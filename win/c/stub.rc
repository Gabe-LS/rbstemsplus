// The start stub's resources: its manifest (RT_MANIFEST 1) and a constant version resource that
// carries only the names (release.md §3.2). Nothing here changes per release (I83): the stub's
// bytes change only when its code does, so a new stub comes only with a code change.
1 24 "stub.manifest"

1 VERSIONINFO
FILEVERSION 0,0,0,0
PRODUCTVERSION 0,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "RB Stems Plus"
            VALUE "ProductName", "RB Stems Plus"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
