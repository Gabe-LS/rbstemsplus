// rbsp-core.dll's version resource (release.md §3.2): ProductName, the full version as
// ProductVersion, FILEVERSION X.Y.Z.0. core/build.sh dll writes core_version.h (V1, V2, V3 and
// VSTR, "1.4.0") from the version it stamps and passes its folder with -I.
#include "core_version.h"

1 VERSIONINFO
FILEVERSION V1,V2,V3,0
PRODUCTVERSION V1,V2,V3,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RB Stems Plus"
            VALUE "FileDescription", "RB Stems Plus core"
            VALUE "FileVersion", VSTR
            VALUE "InternalName", "rbsp-core"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "rbsp-core.dll"
            VALUE "ProductName", "RB Stems Plus"
            VALUE "ProductVersion", VSTR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
