// rbsp-watch.exe's resources: its manifest and its version resource, whose FileDescription names it
// in Task Manager (app.md §5.7). The build writes watch_version.h from VERSION (V1, V2, V3 and
// VSTR, "1.4.0") and passes its folder with -I.
#include "watch_version.h"

1 24 "watch.manifest"

1 VERSIONINFO
FILEVERSION V1,V2,V3,0
PRODUCTVERSION V1,V2,V3,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RB Stems Plus"
            VALUE "FileDescription", "RB Stems Plus Watcher"
            VALUE "FileVersion", VSTR
            VALUE "InternalName", "rbsp-watch"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "rbsp-watch.exe"
            VALUE "ProductName", "RB Stems Plus"
            VALUE "ProductVersion", VSTR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
