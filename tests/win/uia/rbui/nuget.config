<?xml version="1.0" encoding="utf-8"?>
<!-- release.md §9.1 rule 6: nuget.org only, restored in locked mode (packages.lock.json). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
