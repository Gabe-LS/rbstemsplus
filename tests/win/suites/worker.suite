# T17: VM diagnostics for the shipped worker and bridge. From "rekordbox 7.2.19 installed", arm64:
#   tests/win/vm-run.sh stage
#   tests/win/vm-run.sh run "rekordbox 7.2.19 installed" worker
# The share holds the TEST build in dist-test/ (bootstrap.ps1, payload.json, its .sig, the Windows
# zip and the bridge DLL its payload names: scripts/build.sh --test http://10.211.55.2:8766/ ...,
# copied in); its windows.compatible.rekordbox must list 7.2.19, or Install Stems Cache stays off.
# prep sets UAC to elevate an administrator without a prompt in this reverted VM (nothing answers
# the secure desktop in a run): the worker still starts as an elevation, its prompt is by hand.
# cache-hit SKIPs in the VM (see its notes). For the release.list worker row, the release
# check requires RB-KIT's real-PC record (release.md section 8).
include lib/vmlib.ps1
include worker/rblib.ps1
need http
need file repo/core/texts.def
need file dist-test/bootstrap.ps1
need file dist-test/payload.json
# MODE       SECS NAME              SCRIPT
sys          120  prep              worker/prep.ps1
user         600  install           bootstrap/install.ps1
user         600  cache-install     worker/cache-install.ps1
sys          120  cache-files       worker/cache-files.ps1
user         600  rekordbox         worker/rekordbox.ps1
user         60   cache-hit         worker/cache-hit.ps1
