# T17/T8: bootstrap.ps1's -Restore (release.md section 4; by-hand.md's "the three -Restore cases",
# moved here) on the rekordbox snapshot after Stems Cache is installed through the shipped worker
# (worker.suite's first steps). From "rekordbox 7.2.19 logged in":
#   tests/win/vm-run.sh stage
#   tests/win/vm-run.sh run "rekordbox 7.2.19 logged in" restore
# The cases: refused unelevated; restore with the bridge in place; restore with the live DLL
# deleted (R4.I71); refused through a junctioned version folder (I23); restore in
# ConstrainedLanguage (R4.I69). Elevated steps are user-high (the user's full token through a
# scheduled task: no UAC prompt). Every -Restore step SKIPs while the served bootstrap.ps1 has no
# RBSTEMSPLUS_RESTORE. -Restore with Smart App Control On needs a SAC On snapshot and stays by hand
# (by-hand.md). Not a release.list row.
include lib/vmlib.ps1
include worker/rblib.ps1
include restore/rslib.ps1
need http
need file repo/core/texts.def
need file dist-test/bootstrap.ps1
need file dist-test/payload.json
# MODE       SECS NAME                 SCRIPT
sys          120  prep                 worker/prep.ps1
user         600  install              bootstrap/install.ps1
user         600  cache-install        worker/cache-install.ps1
user         180  refused-unelevated   restore/refused.ps1
user-high    300  restore              restore/restore.ps1
sys          60   live-deleted         restore/setup.ps1
user-high    300  restore-missing      restore/restore.ps1
sys          60   junction             restore/setup.ps1
user-high    300  refused-junction     restore/refused.ps1
sys          60   unjunction           restore/setup.ps1
user-high    300  restore-constrained  restore/restore.ps1
