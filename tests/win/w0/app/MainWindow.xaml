<Window x:Class="RbStemsPlus.W0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RB Stems Plus W0" Width="960" Height="540" MinWidth="960" MinHeight="540"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu DockPanel.Dock="Top" x:Name="MenuBar">
      <MenuItem Header="_File" x:Name="FileMenu" />
    </Menu>
    <TextBlock DockPanel.Dock="Top" x:Name="StatusLine" Margin="8" Text="" />
    <TextBlock DockPanel.Dock="Bottom" x:Name="Footer" Margin="8" Text="" />
    <ListView x:Name="Tracks"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              VirtualizingPanel.ScrollUnit="Item">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Track" Width="420">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource Cell}" Text="{Binding Name}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="Result" Width="200">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource Cell}" Text="{Binding Result}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
