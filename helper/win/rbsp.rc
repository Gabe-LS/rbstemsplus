/* The helper's manifest and version. build-win.sh supplies the version defines. */
#define RBSP_STRINGIFY_(x) #x
#define RBSP_STRINGIFY(x) RBSP_STRINGIFY_(x)

1 24 "rbsp.manifest"

1 VERSIONINFO
FILEVERSION RBSP_VERSION_NUM
PRODUCTVERSION RBSP_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "RB Stems Plus"
            VALUE "ProductVersion", RBSP_STRINGIFY(RBSP_VERSION)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
