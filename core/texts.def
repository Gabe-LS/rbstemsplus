/* texts.def: every user-facing text, once, with named slots and a column per OS (mac-core §3.9).
 *
 *   SLOT(name, os)                   a slot a text may use as {name}; os: all | mac | win
 *   TEXT(id, os, mac, win)           os: all | mac | win; win is "" only where Windows never
 *                                    shows the text (the list in core/tests/win_texts.c)
 *
 * The build keeps one column: a Mac build compiles only the mac column (the win strings are never
 * referenced, so they aren't in the objects); under CORE_WIN_POLICY both are kept and core_text's
 * os argument picks. Slots are filtered by OS like every row, so a Windows-only slot never reaches
 * the Mac objects. A test refuses an unknown slot, a "{" that isn't a slot, and tip phrases in
 * action dialogs (M5's lint). At most 64 slots.
 *
 * The Mac column is 1.3.0's own words, byte for byte (sources named; core/tests/texts-in-swift.py
 * checks every piece against app/Sources). Texts are whole sentences where Swift has them;
 * where Swift joins pieces (", " between parts, a list of status lines) the code that ports it
 * joins the same pieces. Log lines aren't texts: they stay the log's own (host->log).
 * The Windows column (W-core, app.md §9) is the Mac's words where they read the same on Windows,
 * and Windows words where they don't (Recycle Bin, File Explorer, this PC, Close rekordbox,
 * Windows Settings). Each Windows text takes exactly its Mac text's slots, so one composer serves
 * both, except where Windows names a place the Mac's words don't: the staging text (no file
 * named), and the three naming rekordbox's folder (T_PREP_NO_REKORDBOX, T_ROOT_MISSING_MSG,
 * T_ROOT_FOLDER_CLEANUP_MSG), whose {dir} is <Program Files>\rekordbox under Windows' own Program
 * Files, on whichever drive (dialog_texts.c's w_rb_dir_slot). "" (core_text answers CORE_E_NOTYET) only for the Mac-only
 * paths: the password sheet, App Management's "Permission needed", Time Machine, Apple silicon,
 * macOS's privacy prompt, another account's app and the bundle's re-sign. core/tests/win_texts.c
 * holds that list, the slot rule and the Mac words Windows never says. Windows-only rows (tagged
 * win, "" in the mac column) are at the end.
 */
#ifndef SLOT
#define SLOT(name, os)
#endif
#ifndef TEXT
#define TEXT(id, os, mac, win)
#endif

SLOT(version,  all)
SLOT(drive,    all)
SLOT(engine,   all)
SLOT(gb,       all)
SLOT(playlist, all)
SLOT(n,        all)
SLOT(m,        all)
SLOT(time,     all)
SLOT(size,     all)
SLOT(share,    all)
SLOT(limit,    all)
SLOT(name,     all)
SLOT(why,      all)
SLOT(state,    all)
SLOT(connect,  all)
SLOT(rekordbox, all)
SLOT(ort,      all)
SLOT(action,   all)
SLOT(label,    all)
SLOT(dir,      all)
SLOT(path,     all)
SLOT(message,  all)
SLOT(details,  all)
SLOT(stems,    all)
SLOT(features, all)

