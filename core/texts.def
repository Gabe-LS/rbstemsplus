/* ---------------------------------------------------------------- Windows only (W-core, app.md §9) */

/* "rekordbox is still closing" (PLAN R1, app.md §5.5): rekordbox's process lingers about 75 s after
 * its window closes; the flow waits for it with this status line */
TEXT(T_WIN_STILL_CLOSING,     win, "", "rekordbox is still closing…")
/* the update-first offer (I76, J23): the worker in <Program Files> speaks another protocol, or its
 * floor refuses this app's payload (exit 12, 14), or no worker can serve this app */
TEXT(T_WIN_UPDATE_FIRST_TITLE, win, "", "Update RB Stems Plus first")
TEXT(T_WIN_UPDATE_FIRST_MSG,  win, "", "Stems Cache on this PC was installed by a newer RB Stems Plus: update RB Stems Plus, then try again.")
/* R1's light, text and "put Pioneer's file back" flow (app.md §5.2, §5.5 restore) */
TEXT(T_WIN_R1_LIVE_MISSING,   win, "", "rekordbox's onnxruntime.dll is missing, so rekordbox can't separate stems. Click Put Back Pioneer's File.")
TEXT(T_WIN_R1_LIVE_FOREIGN,   win, "", "rekordbox's onnxruntime.dll isn't Pioneer's or RB Stems Plus's, so rekordbox may not separate stems. Click Put Back Pioneer's File.")
TEXT(T_WIN_R1_ORT_MISSING,    win, "", "Stems Cache's copy of rekordbox's ONNX Runtime is missing, so rekordbox can't separate stems. Click Put Back Pioneer's File.")
TEXT(T_WIN_BTN_RESTORE,       win, "", "Put Back Pioneer's File")
TEXT(T_WIN_RESTORE_Q,         win, "", "Put back Pioneer's file?")
TEXT(T_WIN_RESTORE_MSG,       win, "", "Puts rekordbox's own onnxruntime.dll back. Stems Cache stays off until you reinstall it.")
TEXT(T_WIN_RESTORING,         win, "", "Putting back Pioneer's file…")
TEXT(T_WIN_RESTORE_FAILED,    win, "", "Put back failed")
TEXT(T_WIN_RESTORE_NOT_DONE,  win, "", "Pioneer's file couldn't be put back.")
/* the uninstall's last file, removed at the next restart (I20): said only when it applies */
TEXT(T_WIN_REMOVED_AT_RESTART, win, "", " One file of RB Stems Plus is removed when Windows restarts.")
/* start-up refusals (app.md §5.9): UAC off (I35), the minimum Windows (I34) and .NET */
TEXT(T_WIN_START_UAC_OFF,     win, "", "RB Stems Plus can't run while User Account Control is off. Turn it on, restart Windows, then open RB Stems Plus again.")
TEXT(T_WIN_START_OLD_WINDOWS, win, "", "RB Stems Plus needs Windows 11, version 22H2 or later.")
TEXT(T_WIN_START_OLD_NET,     win, "", "RB Stems Plus needs .NET Framework 4.8.1 or later. Install it with Windows Update, then open RB Stems Plus again.")
/* bootstrap.ps1's Smart App Control refusal (I69, R16), here for W14a's table of Windows texts */
TEXT(T_WIN_SAC_ON,            win, "", "Smart App Control is on, so RB Stems Plus can't be installed. Turn it off in Windows Security › App & browser control › Smart App Control, then run the install command again.")

/* the update-first offer when no newer RB Stems Plus can be found (review C1): one button */
TEXT(T_WIN_NO_NEWER_MSG,      win, "", "Stems Cache on this PC was installed by a newer RB Stems Plus, and no newer version can be downloaded now. Try again later.")
/* "rekordbox open" after the wait, when rekordbox's window is gone but its process still runs
 * (review C14): the Try Again ask's and the OK alert's words */
TEXT(T_WIN_STILL_CLOSING_TRY, win, "", "rekordbox hasn't finished closing. Click Try Again in a moment.")
TEXT(T_WIN_STILL_CLOSING_MSG, win, "", "rekordbox hasn't finished closing. Try again in a moment.")
/* appended (HF7): FEAT_NOT_CHECKED's line */
TEXT(T_WIN_CACHE_NOT_CHECKED, win, "", "Stems Cache couldn't check rekordbox just now.")
/* the nameless forms (review NR2; owner, 2026-11-13): a {drive} text whose drive has no name ("":
 * unplugged, no label remembered; a letter is never shown for it) says "Stems Cache's drive".
 * Picked only on Windows, by drive_text, location_light, paused_text and the not-connected flow
 * texts. A connected drive with neither a label nor a letter (folder-mounted, or its letter
 * removed) also gives "": its connected-only texts' nameless forms are appended below (review
 * NT1, NT2) */
TEXT(T_WIN_LOC_CHECKING_NAMELESS,      win, "", "Stems Cache is still checking its drive.")
TEXT(T_WIN_LOC_AGAIN_SOON_NAMELESS,    win, "", "Stems Cache will use its drive again in a few seconds.")
TEXT(T_WIN_LOC_NOT_USING_NAMELESS,     win, "", "Stems Cache isn't using its drive right now: {why}")
TEXT(T_WIN_LOC_BRIDGE_TOO_OLD_NAMELESS, win, "", "Stems Cache needs an update to save stems on its drive: it's saving them on this PC for now. Click Reinstall Stems Cache.")
TEXT(T_WIN_LOC_NOT_CONNECTED_NAMELESS, win, "", "Stems Cache's drive isn't connected: rekordbox separates tracks as usual. {connect}")
TEXT(T_WIN_LOC_FOLDER_MISSING_NAMELESS, win, "", "Stems Cache's folder on its drive is missing or was replaced.")
TEXT(T_WIN_LOC_LINK_NAMELESS,          win, "", "Stems Cache isn't saving: a folder on the way to Stems Cache's folder on its drive is a link.")
TEXT(T_WIN_LOC_NETWORK_NAMELESS,       win, "", "Stems Cache isn't saving: Stems Cache's drive is a network drive. Choose a drive connected to this PC in Settings.")
TEXT(T_WIN_LOC_READ_ONLY_NAMELESS,     win, "", "Stems Cache's drive is read-only; Windows may need to repair it (the drive's Properties › Tools › Check in File Explorer).")
TEXT(T_WIN_LOC_NO_PERMISSION_NAMELESS, win, "", "RB Stems Plus isn't allowed to use Stems Cache's drive. Check the folder's permissions (Properties › Security in File Explorer).")
TEXT(T_WIN_CACHE_PAUSED_NAMELESS,      win, "", "Stems Cache stopped saving stems: its drive has less than {gb} GB free.")
TEXT(T_WIN_CACHE_PAUSED_AT_INSTALL_NAMELESS, win, "", "Stems Cache will stop saving stems while its drive has less than {gb} GB free.")
TEXT(T_WIN_LEFT_DRIVE_NOT_CONNECTED_NAMELESS, win, "", "The stems saved on Stems Cache's drive stay: it isn't connected. To delete them, delete the folder \"{dir}\" in File Explorer.")
TEXT(T_WIN_REMOVAL_NOTE_NOT_CONNECTED_NAMELESS, win, "", " (its stems on Stems Cache's drive, which isn't connected, stay)")
TEXT(T_WIN_UNINSTALL_ALL_DRIVE_GONE_NAMELESS, win, "", "RB Stems Plus will be deleted. Its stems on Stems Cache's drive, which isn't connected, stay: connect it first to delete them too.")
TEXT(T_WIN_OLD_DRIVE_STAYS_NAMELESS,   win, "", "The stems saved on the previous drive stay there.")
/* appended (review NT1): the connected-only nameless forms, for a chosen drive that has neither a
 * label nor a letter now (folder-mounted, or its letter removed). Picked only on Windows, by
 * nameless_text; none has a {drive} slot */
TEXT(T_WIN_UNINSTALL_ALL_DRIVE_NAMELESS, win, "", "RB Stems Plus will be deleted, including all stems saved in its folder on Stems Cache's drive{size}, also any saved there by other computers or accounts.")
TEXT(T_WIN_REMOVAL_NOTE_CONNECTED_NAMELESS, win, "", ", including all stems saved in its folder on Stems Cache's drive{size}, also any saved there by other computers or accounts")
TEXT(T_WIN_DELETING_DRIVE_NAMELESS,    win, "", "Deleting the stems saved on Stems Cache's drive…")
TEXT(T_WIN_DELETING_DRIVE_N_NAMELESS,  win, "", "Deleting the stems saved on Stems Cache's drive… {n} files")
TEXT(T_WIN_LEFT_DRIVE_PARTLY_NAMELESS, win, "", "Some of the stems saved on Stems Cache's drive couldn't be deleted: delete the folder \"{dir}\" in File Explorer.")
TEXT(T_WIN_LEFT_DRIVE_NOT_NAMED_NAMELESS, win, "", "The stems saved on Stems Cache's drive stay. To delete them, delete the folder \"{dir}\" in File Explorer.")
TEXT(T_WIN_CLEAR_LOCATION_MSG_NAMELESS, win, "", "Deletes all stems saved in this folder on Stems Cache's drive, including any saved there by other computers or accounts.")
TEXT(T_WIN_CLEARING_DRIVE_NAMELESS,    win, "", "Clearing saved stems on Stems Cache's drive…")
TEXT(T_WIN_CLEARING_DRIVE_N_NAMELESS,  win, "", "Clearing saved stems on Stems Cache's drive… {n} files")
TEXT(T_WIN_NOT_CLEARED_DRIVE_MSG_NAMELESS, win, "", "Some saved stems on Stems Cache's drive couldn't be deleted ({why}).")
/* appended (review NT2): Settings' location row for that drive; {path} is " › " and the folders
 * below the drive's root, "" at the root */
TEXT(T_WIN_LOCATION_LABEL_NAMELESS,    win, "", "Stems Cache location: Stems Cache's drive{path}")
/* appended (review NT1; owner, 2026-11-15): Settings refuses to choose a drive with neither a
 * label nor a letter, so its Use, Found, Looking and Can't create texts need no nameless form */
TEXT(T_WIN_REFUSE_NAMELESS,            win, "", "That folder's drive has no name and no drive letter. Choose another folder.")
/* appended (owner, 2026-11-16): the after-exit's one dialog (win/c/afterexit.c), when it kept the
 * app files and the Apps & features entry because a program still ran from the apps folder after
 * the 60 s wait, or the process list stayed unknown; no program named (its path is in the log) */
TEXT(T_WIN_UNINSTALL_KEPT,             win, "", "RB Stems Plus couldn't be fully uninstalled because part of it is still running, maybe in another session of your Windows account. Restart Windows, then uninstall it again from Apps & features.")
#undef SLOT
#undef TEXT
